# Copy to .env.local and fill with your own values. Never commit real secrets.
# Prefixes: NEXT_PUBLIC_* are exposed to the browser bundle. Everything else is server-only.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Cloudflare Turnstile anti-bot protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public Google Form URL shown when an Early Access period expires.
NEXT_PUBLIC_EARLY_ACCESS_FEEDBACK_URL=

# Comma-separated admin email allowlist for the solo-developer bootstrap.
# Example: ADMIN_EMAILS=you@example.com
ADMIN_EMAILS=

# Secret used to authenticate the Vercel cron cleanup endpoint, if enabled.
CRON_SECRET=

# V1 payment flow is manual: admin confirms payment and generates a one-time activation code.
# No payment-provider webhook secret is required for V1.
