# Copy to .env.local and fill with your own values. Never commit real secrets.
# Prefixes: NEXT_PUBLIC_* are exposed to the browser bundle. Everything else is server-only.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_API_SECRET=

# Comma-separated admin email allowlist for the solo-developer bootstrap.
# Example: ADMIN_EMAILS=you@example.com
ADMIN_EMAILS=

# Secret used to authenticate the Vercel cron cleanup endpoint.
CRON_SECRET=
